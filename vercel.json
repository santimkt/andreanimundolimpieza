{
  "version": 2,
  "builds": [
    {
      "src": "api/orders.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/generate.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/orders",
      "dest": "/api/orders.js"
    },
    {
      "src": "/api/generate",
      "dest": "/api/generate.py"
    }
  ]
}
